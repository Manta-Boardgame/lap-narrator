{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lap-narrator/script",
  "type": "object",
  "required": [
    "format",
    "version",
    "projectId",
    "title",
    "scriptHash",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lap-narrator/script"
    },
    "version": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "scriptHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slideId",
          "order",
          "text",
          "recordable",
          "textHash"
        ],
        "additionalProperties": false,
        "properties": {
          "slideId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "recordable": {
            "type": "boolean"
          },
          "speaker": {
            "type": "string"
          },
          "targetSec": {
            "type": "number",
            "minimum": 0
          },
          "image": {
            "type": "string"
          },
          "imageSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "textHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
