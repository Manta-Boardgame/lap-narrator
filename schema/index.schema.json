{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lap-narrator/index",
  "type": "object",
  "required": [
    "format",
    "version",
    "exportId",
    "kind",
    "projectId",
    "sessionId",
    "volumes",
    "zips"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lap-narrator/index"
    },
    "version": {
      "const": 1
    },
    "exportId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "full",
        "final"
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,64}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,64}$"
    },
    "volumes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "zips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "volume",
          "file",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "volume": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "file": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
