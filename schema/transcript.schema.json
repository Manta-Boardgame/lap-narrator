{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lap-narrator/transcript",
  "description": "Word-level transcript of one audio file (dev/PLAN2.md, CONTRACTS.md 7.8). Times are seconds. Extra keys (engine, params, timing, ...) are allowed.",
  "type": "object",
  "required": [
    "format",
    "version",
    "audio",
    "model",
    "words",
    "segments"
  ],
  "properties": {
    "format": {
      "const": "lap-narrator/transcript"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "audio": {
      "type": "object",
      "required": [
        "sha256",
        "samples"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 9007199254740991
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "model": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "w",
          "start",
          "end"
        ],
        "properties": {
          "w": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object"
    },
    "engine": {
      "type": "object"
    },
    "params": {
      "type": "object"
    }
  }
}
