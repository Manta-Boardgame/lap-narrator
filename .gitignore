# Dependencies and environments (installed by the user with npm / pip)
node_modules/
.venv/
__pycache__/
*.pyc
models/

# Working folders and local tools
work/
tools/
dev/

# Generated by the Android build (native/scripts/prepare-www.mjs)
native/www/

# Android build output, SDK location and signing keys
android/build/
android/.gradle/
android/**/build/
android/local.properties
android/capacitor-cordova-android-plugins/
*.jks
*.keystore
*.apk
*.aab

# Recordings and output media (the small sample WAV/ZIP files under examples/ are kept)
*.pcm
*.mp4
*.webm
*.mkv
*.mov
*.wav
!examples/**/*.wav
*.zip
!examples/**/*.zip

# Logs, caches, editor and OS files
*.log
.cache/
.DS_Store
Thumbs.db
.vscode/
.idea/
.env
.env.*
